# Copy to .env.local and rebuild after changes.
NEXT_PUBLIC_SIGNUP_PATH=/signup/
# Draft Module 5 browser event adapter; no remote analytics delivery is built in.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# A = Find my starting point; B = Discover my starting point.
NEXT_PUBLIC_AB_ENABLED=false
# Blank uses the current origin. Set your deployed HTTPS origin for public referral links.
NEXT_PUBLIC_SITE_URL=
