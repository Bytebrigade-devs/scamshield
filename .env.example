NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never prefix this secret with NEXT_PUBLIC or commit .env.local.
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key

# Optional transactional email for backend trial-start confirmations (Resend).
# Create the key in the Resend dashboard with permission "Sending access" (not Full access) and
# restrict it to the verified sending domain: this app only ever calls POST /emails. A key value can
# never be read again after creation, so name it something findable (for example
# "scamshield-m2-auth") and keep it only in .env.local / the host's environment.
RESEND_API_KEY=your-resend-api-key
TRIAL_EMAIL_FROM=ScamShield <trials@your-verified-domain.example>
# Required for the signup confirmation link AND the password-reset code: both routes email through
# Resend and fall back to TRIAL_EMAIL_FROM when AUTH_EMAIL_FROM is unset. Without a key and a sender
# each route answers 503 "Email delivery is not configured" instead of claiming a message was sent.
# Use an address on a domain verified with Resend (SPF + DKIM, and DMARC on the sending subdomain).
AUTH_EMAIL_FROM=ScamShield <no-reply@your-verified-domain.example>
# Optional Reply-To for every auth email. The From address above must sit on a domain verified with
# Resend — gmail.com is refused with 403 — but replies can point at any inbox, so this is where a
# human answers. Leave unset for no Reply-To header.
# AUTH_EMAIL_REPLY_TO=support@your-domain.example
# How long an emailed confirmation link or reset code stays usable, in seconds. Default 300 (5 min).
# Supabase enforces this, not this app: set the project's email OTP expiry
# (mailer_otp_expiry) to the SAME value. This variable drives the email copy and the countdown only.
# Verify the two agree with: node scripts/check-otp-expiry.cjs
AUTH_OTP_EXPIRY_SECONDS=300
# LOCAL DEVELOPMENT ONLY. With no Resend key, AUTH_MAIL_DRIVER=outbox writes the message to
# AUTH_MAIL_OUTBOX (default .dev-outbox, gitignored) and prints it in the server terminal instead
# of emailing it. A production build refuses this driver and returns 503, so it cannot leak codes.
# Resend always wins when a key and sender are present, so remove this once a key is configured: a
# missing key should then fail loudly instead of quietly writing reset codes to disk.
AUTH_MAIL_DRIVER=outbox
AUTH_MAIL_OUTBOX=.dev-outbox

# backend (default) uses Supabase accounts and database; demo uses browser dummy data.
NEXT_PUBLIC_M2_MODE=backend
