NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never prefix this secret with NEXT_PUBLIC or commit .env.local.
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key

# Optional transactional email for backend trial-start confirmations (Resend).
# Use a sender address on a domain verified with Resend.
RESEND_API_KEY=your-resend-api-key
TRIAL_EMAIL_FROM=ScamShield <trials@your-verified-domain.example>

# backend (default) uses Supabase accounts and database; demo uses browser dummy data.
NEXT_PUBLIC_M2_MODE=backend
