NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never prefix this secret with NEXT_PUBLIC or commit .env.local.
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key

# Optional transactional email for backend trial-start confirmations (Resend).
# Use a sender address on a domain verified with Resend.
RESEND_API_KEY=your-resend-api-key
TRIAL_EMAIL_FROM=ScamShield <trials@your-verified-domain.example>

# backend (default) uses Supabase accounts and database; demo uses browser dummy data.
NEXT_PUBLIC_M2_MODE=backend

# M4 durable checker store (SERVER-SIDE ONLY). Leave all three unset: the checker then uses its
# in-memory port, which is what every deployment does today. Setting M4_DURABLE_STORE=1 also
# requires M4_SUPABASE_URL and M4_SUPABASE_SERVICE_ROLE_KEY — the selection fails closed and
# throws at startup if they are missing, rather than silently falling back to memory.
# A durable check/history/feedback row needs a verified auth user uuid; events accept any
# subject reference.
# M4_DURABLE_STORE=1
# M4_SUPABASE_URL=
# M4_SUPABASE_SERVICE_ROLE_KEY=

# M4 checker AI provider (SERVER-SIDE ONLY). Leave OPENAI_API_KEY unset for rules-only checks.
# When set, /api/check and /api/config read it via liveConfigFromEnv(); the browser never sees it.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=            # OpenAI-compatible gateway base URL (or M4_UI_BASE_URL)
# M4_UI_API=chat              # "chat" or "responses"
# M4_UI_MODEL=gpt-6-luna
# M4_UI_FALLBACK_MODEL=gpt-5.6-luna
# M4_UI_DEADLINE_MS=7000      # integer 5000-60000 (default 7000)
# M4_UI_MAX_OUTPUT_TOKENS=4096
