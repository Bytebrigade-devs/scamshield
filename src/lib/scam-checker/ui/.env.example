# ScamShield local checker — test credentials (SERVER-SIDE ONLY).
# Copy this file to .env.local and fill in values. Never commit or share .env.local.
# The local server/smoke runner read this file; hosted functions use Netlify environment variables.
# The browser never receives the key.
OPENAI_API_KEY=
# Base URL of an OpenAI-compatible endpoint (the adapter appends /chat/completions if absent).
OPENAI_BASE_URL=
# Transport style: "chat" (default) for /chat/completions, or "responses" for /responses
# (e.g. AgentRouter at https://agentrouter.org/v1).
M4_UI_API=chat
# Model id served by that endpoint. Leave blank to use the boundary default (gpt-6-luna).
M4_UI_MODEL=
# Optional single fallback model. Blank = no fallback. When set, a transport failure on the primary
# (timeout / network / http-error) gets exactly one attempt here. Never used for invalid or refused
# output, never retried for a more confident answer (owner decision 22 Nov 2026).
M4_UI_FALLBACK_MODEL=
# AI completion budget: integer 512–8192 (default 4096).
M4_UI_MAX_OUTPUT_TOKENS=4096
# AI deadline in milliseconds: integer 5000–60000 (default 45000).
M4_UI_DEADLINE_MS=45000
# Optional local port for the checker server.
M4_UI_PORT=4173
